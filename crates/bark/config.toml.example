# Copy this file to config.toml and fill in your values

# gRPC server configuration
address = "127.0.0.1"
port = 50051

# TLS is required unless plaintext is explicitly allowed.
tls_enable = false
allow_insecure = true
tls_cert_path = "certs/server.crt"
tls_key_path = "certs/server.key"
tls_client_ca_path = "certs/ca.pem"

# Bark backend configuration
[backend]
# BIP39 mnemonic - REQUIRED
# Generate with: cargo install bip39-cli && bip39 generate 12
mnemonic = "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# Bark server address (default: Second's server)
server_address = "https://ark.second.tech"

# Esplora API address for on-chain data
esplora_address = "https://mempool.second.tech/api"

# Bitcoin network: mainnet, testnet, signet, regtest
network = "mainnet"

# Data directory for SQLite database
data_dir = ".data/bark"

# Delay between payment event polling passes in milliseconds (must be > 0)
event_poll_interval_ms = 5000

# Payment methods this backend advertises to the mint.
#
# A mint picks its backend per (unit, method) pair and claims every method a
# backend advertises. Leave this unset to advertise everything bark supports,
# which is what a mint backed only by bark wants.
#
# Name a subset to run bark alongside another backend. For example, to let a
# Core Lightning node keep bolt11 while bark serves on-chain deposits:
#   payment_methods = ["onchain"]
#
# Supported values: bolt11, onchain, arkoor
# payment_methods = ["bolt11", "onchain", "arkoor"]
