# Copy this file to config.toml and fill in your values

# gRPC server configuration
address = "127.0.0.1"
port = 50051

# TLS is required unless plaintext is explicitly allowed.
tls_enable = false
allow_insecure = true
tls_cert_path = "certs/server.crt"
tls_key_path = "certs/server.key"
tls_client_ca_path = "certs/ca.pem"

# LDK Server node connection
[ldk]
# gRPC address of the LDK Server node, without scheme
address = "127.0.0.1:3536"
# HMAC API key (64-char hex)
api_key = "your-api-key-hex-here"
# PEM certificate to pin for the LDK Server connection
tls_cert_path = "certs/ldk-server.crt"

# Melt quote fee reserve (defaults shown)
fee_reserve_min_sat = 2
fee_reserve_percent = 0.01
max_payment_scan_pages = 32

# Payment methods this backend advertises to the mint.
#
# A mint picks its backend per (unit, method) pair and claims every method a
# backend advertises. Leave this unset to advertise everything supported.
#
# Name a subset to run alongside another backend, for example to leave bolt11
# to a different processor:
#   payment_methods = ["bolt12"]
#
# Supported values: bolt11, bolt12
# payment_methods = ["bolt11", "bolt12"]
