# CDK Payment Processor for LNbits

default:
    @just --list

check:
    cargo check --locked

build:
    cargo build --locked

run:
    cargo run --locked

test:
    cargo test --locked

# Run the opt-in LNbits Regtest suite
test-regtest:
    CARGO_INCREMENTAL=0 RUST_LOG=info cargo test --locked --features regtest-tests --test regtest -- --ignored --nocapture --test-threads=1

lint:
    cargo clippy --locked --all-targets -- -D warnings

fmt:
    cargo fmt

fmt-check:
    cargo fmt -- --check

ci: fmt-check check test lint
    @echo "All checks passed!"
